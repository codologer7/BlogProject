{
  "version": 2,
  "builds": [
    {
      "src": "blogproject/wsgi.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "15mb", "runtime": "python3.11" }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "blogproject/wsgi.py"
    }
  ],
  "env": {
    "PYTHON_VERSION": "3.11",
    "DEBUG": "False"
  }
}

