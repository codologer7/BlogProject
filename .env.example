# Django Settings
DEBUG=False
SECRET_KEY=your-secret-key-here

# ALLOWED_HOSTS for different platforms:
# For Vercel: *.vercel.app,localhost,127.0.0.1
# For Render: your-app.onrender.com,localhost,127.0.0.1
# For localhost development: localhost,127.0.0.1
ALLOWED_HOSTS=*.vercel.app,localhost,127.0.0.1

# Database (Optional)
DATABASE_URL=sqlite:///db.sqlite3

# Email (Optional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
